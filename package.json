{
  "name": "sturm",
  "version": "1.0.0",
  "private": true,
  "description": "Discord AI bot built on Cloudflare Workers",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var STURM_DEBUG_ENABLED:true",
    "start": "wrangler dev --var STURM_DEBUG_ENABLED:true",
    "deploy": "wrangler deploy",
    "types": "wrangler types env.d.ts --env-file /dev/null",
    "types:check": "wrangler types env.d.ts --check --env-file /dev/null",
    "format": "oxfmt --write .",
    "lint": "oxlint src/",
    "check": "npm run types:check && oxfmt --check . && oxlint src/ && tsc",
    "test": "vitest run --config vitest.config.ts",
    "test:ai": "STURM_RUN_DEBUG_AI_INTEGRATION=true vitest run --config vitest.config.ts tests/debug-ai.integration.test.ts --reporter verbose",
    "bench:prompt-replay": "STURM_RUN_PROMPT_REPLAY=true vitest run --config vitest.config.ts tests/prompt-replay.benchmark.test.ts --reporter verbose"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.27",
    "@cloudflare/codemode": "^0.5.1",
    "@cloudflare/shell": "^0.4.3",
    "@cloudflare/think": "^0.15.1",
    "agents": "^0.20.1",
    "ai": "^7.0.48",
    "discord-api-types": "^0.38.52",
    "discord-interactions": "^4.4.0",
    "liquidjs": "^10.28.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
