{
  "name": "sturm",
  "version": "1.0.0",
  "private": true,
  "description": "Discord AI bot built on Cloudflare Workers",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var STURM_DEBUG_ENABLED:true",
    "start": "wrangler dev --var STURM_DEBUG_ENABLED:true",
    "deploy": "wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "format": "oxfmt --write .",
    "lint": "oxlint src/",
    "check": "oxfmt --check . && oxlint src/ && tsc",
    "test": "vitest run --config vitest.config.ts",
    "test:ai": "STURM_RUN_DEBUG_AI_INTEGRATION=true vitest run --config vitest.config.ts tests/debug-ai.integration.test.ts --reporter verbose",
    "bench:prompt-replay": "STURM_RUN_PROMPT_REPLAY=true vitest run --config vitest.config.ts tests/prompt-replay.benchmark.test.ts --reporter verbose"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.86",
    "@cloudflare/ai-chat": "^0.8.5",
    "@cloudflare/codemode": "^0.4.0",
    "@cloudflare/shell": "^0.4.0",
    "@cloudflare/think": "^0.9.0",
    "@cloudflare/worker-bundler": "^0.2.0",
    "agents": "^0.16.0",
    "ai": "^6.0.206",
    "discord-api-types": "^0.38.47",
    "discord-interactions": "^4.4.0",
    "liquidjs": "^10.27.0",
    "workers-ai-provider": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.12",
    "@cloudflare/workers-types": "^4.20260519.1",
    "@types/node": "^25.8.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.66.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.93.0"
  }
}
