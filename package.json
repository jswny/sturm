{
  "name": "sturm",
  "version": "1.0.0",
  "private": true,
  "description": "Discord AI bot built on Cloudflare Workers",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var STURM_DEBUG_ENABLED:true",
    "start": "wrangler dev --var STURM_DEBUG_ENABLED:true",
    "deploy": "wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "format": "oxfmt --write .",
    "lint": "oxlint src/",
    "check": "oxfmt --check . && oxlint src/ && tsc"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.7.1",
    "agents": "^0.13.0",
    "ai": "^6.0.185",
    "discord-api-types": "^0.38.47",
    "discord-interactions": "^4.4.0",
    "workers-ai-provider": "^3.1.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260519.1",
    "@types/node": "^25.8.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.66.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.93.0"
  }
}
